      {
        "id": 9849,
        "chapter_id": 95,
        "subject_id": 7,
        "sort_order": 6,
        "type": "dialogue",
        "content": "أرى. كنفسي في المستقبل، إذا حكمت على شيء واحد في كل مرة باستخدام المعرفة التي تعلمتها، يجب أن أقترب من حلمي أيضًا بالتأكيد!",
        "character_id": 3,
        "variant_id": 36,
        "image": null,
        "video": null,
        "question_id": null,
        "created_at": "2026-09-08T01:25:16Z",

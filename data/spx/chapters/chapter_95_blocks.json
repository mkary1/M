      },
      {
        "id": 9848,
        "chapter_id": 95,
        "subject_id": 7,
        "sort_order": 5,
        "type": "dialogue",
        "content": "تحصل على وظيفة، وتبدأ العيش بمفردك، ثم الزواج، والسكن، وتربية الأطفال، ويومًا ما، حلمك، محلك الخاص. عند كل من هذه المحطات، ينتظر خيار مهم متعلّق بالمال.",
        "character_id": 4,
        "variant_id": 49,
        "image": null,
        "video": null,
        "question_id": null,
        "created_at": "2026-09-08T01:25:16Z",

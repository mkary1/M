      },
      {
        "id": 10791,
        "chapter_id": 105,
        "subject_id": 7,
        "sort_order": 10,
        "type": "dialogue",
        "content": "أرى. بدء مشروع تجاري ليس حفظ إجابة صحيحة واحدة - إنه الاختيار بنفسك في كل مشهد. أشعر أن هناك شيئًا لا تراه إلا بعد التجربة.",
        "character_id": 3,
        "variant_id": 42,
        "image": null,
        "video": null,
        "question_id": null,
        "created_at": "2026-09-08T01:25:22Z",
        "updated_at": null,
        "character": {
          "id": 3,
          "name": "آدم",
          "language": "ar",
          "is_active": true,

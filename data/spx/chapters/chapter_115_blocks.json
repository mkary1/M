      {
        "id": 11641,
        "chapter_id": 115,
        "subject_id": 7,
        "sort_order": 19,
        "type": "dialogue",
        "content": "إذا أصبحت قادرًا على صنع أفضل محفظة، ربما أستطيع أن أصبح مستثمرًا حقيقيًا! حسنًا، بتذكّر ما تعلمته حتى الآن، سأُنهي المهمة بالتأكيد.",
        "character_id": 3,
        "variant_id": 36,
        "image": null,
        "video": null,
        "question_id": null,

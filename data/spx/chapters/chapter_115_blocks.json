      },
      {
        "id": 11642,
        "chapter_id": 115,
        "subject_id": 7,
        "sort_order": 20,
        "type": "dialogue",
        "content": "قبل الانطلاق، لنتحقق من التعلّم حتى الآن كـ&#34;عناصر معرفية&#34;. بما أنه الملخص الكبير لكل ما سبق، جهّزت عناصر معرفية كثيرة أيضًا. رتّبتها بحسب نوع المشهد الذي تُستخدم فيه المعرفة، فلنتحقق منها معًا قبل الانطلاق!",
        "character_id": 4,
        "variant_id": 54,
        "image": null,
        "video": null,
        "question_id": null,
        "created_at": "2026-09-08T01:25:26Z",

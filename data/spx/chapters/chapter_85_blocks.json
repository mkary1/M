      {
        "id": 8543,
        "chapter_id": 85,
        "subject_id": 7,
        "sort_order": 5,
        "type": "dialogue",
        "content": "يُسمى &#34;محاكي العمل الافتراضي&#34;. تدخل مساحة افتراضية وتتخذ قرارات واحدًا تلو الآخر بشأن ما يحدث أمام عينيك، من التنقّل الصباحي إلى إدارة ميزانية الأسرة في المساء.",
        "character_id": 4,
        "variant_id": 49,
        "image": null,
        "video": null,
        "question_id": null,
        "created_at": "2026-09-08T01:25:11Z",
